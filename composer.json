{
    "name": "oi-lab/oi-laravel-documentation",
    "description": "A Laravel package for managing markdown-based documentation with hierarchical navigation and search",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OiLab",
            "email": "contact@oilab.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "symfony/yaml": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "OiLab\\LaravelDocumentation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OiLab\\LaravelDocumentation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/pest"
        ],
        "sync-ai-skills": [
            "@php scripts/sync-ai-skills.php"
        ],
        "post-autoload-dump": [
            "@php scripts/sync-ai-skills.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "OiLab\\LaravelDocumentation\\OiLaravelDocumentationServiceProvider"
            ]
        },
        "oi-lab": {
            "skills": [
                {
                    "name": "oilab-laravel-docs",
                    "description": "Write and organize project documentation pages",
                    "path": "resources/skills/oilab-laravel-docs",
                    "rules": "resources/stubs/claude-rules.md",
                    "section": "oi-lab/oi-laravel-documentation rules"
                }
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
